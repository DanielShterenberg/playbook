rules_version = '2';

// Firestore security rules — implements issues #85 and #76.
//
// Data model:
//   users/{userId}           — user profile (teamId, pendingTeamId: where the app looks first)
//   teams/{teamId}           — team document; the members map is the truth:
//                              { [userId]: { role: "admin"|"editor"|"viewer", name?, email? } }
//   teams/{teamId}/requests/{userId} — join request { uid, name, email, status, createdAt }
//   invites/{inviteCode}     — { teamId, teamName } for people outside the team
//   plays/{playId}           — flat play collection (teamId="" for solo users)
//   sharedPlays/{shareToken} — lightweight public share token { playId, createdBy, snapshot, teamName? }

service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------------
    // Helpers
    // -----------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    // The person who runs the app: sees and can delete everything (the
    // /admin page). Matched on a verified sign-in email; Google sign-in
    // always verifies it.
    function isAppOwner() {
      return isSignedIn()
        && request.auth.token.email == "15daniel10@gmail.com"
        && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function teamData(teamId) {
      return get(/databases/$(database)/documents/teams/$(teamId)).data;
    }

    function isMember(teamId) {
      return isSignedIn() && teamId != "" && request.auth.uid in teamData(teamId).members;
    }

    function memberRole(teamId) {
      return teamData(teamId).members[request.auth.uid].role;
    }

    function isAdmin(teamId) {
      return isMember(teamId) && memberRole(teamId) == "admin";
    }

    function isEditor(teamId) {
      return isMember(teamId) && (memberRole(teamId) == "admin" || memberRole(teamId) == "editor");
    }

    // -----------------------------------------------------------------------
    // Users
    // -----------------------------------------------------------------------

    match /users/{userId} {
      allow read:   if isAppOwner() || isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
    }

    // -----------------------------------------------------------------------
    // Teams (#74, #75, #76)
    // -----------------------------------------------------------------------

    match /teams/{teamId} {
      // Any team member may read the team document
      allow read: if isAppOwner() || isMember(teamId);

      // A new team has exactly one member: its creator, as admin
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && request.resource.data.members[request.auth.uid].role == "admin";

      // Admins change the team (approve, remove). A member may only refresh
      // their own name / email entry, keeping their role. Nobody adds
      // themselves: joining goes through a request an admin approves.
      // A member who is not an admin may leave.
      allow update: if isAppOwner() || isAdmin(teamId) || isOwnProfileUpdate(teamId) || isLeaving(teamId);

      // Only the app owner deletes a team.
      allow delete: if isAppOwner();

      // Join requests: the requester files their own, pending, and may
      // withdraw it; an admin approves / declines (status) or deletes it.
      match /requests/{userId} {
        allow read: if isAppOwner() || isOwner(userId) || isAdmin(teamId);
        allow create, update: if (isOwner(userId) && isValidRequest(userId)) || isAdmin(teamId);
        allow delete: if isAppOwner() || isOwner(userId) || isAdmin(teamId);
      }
    }

    function isOwnProfileUpdate(teamId) {
      let before = resource.data.members;
      let after = request.resource.data.members;
      return isMember(teamId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["members"])
        && after.diff(before).affectedKeys().hasOnly([request.auth.uid])
        && request.auth.uid in after
        && after[request.auth.uid].role == before[request.auth.uid].role
        && after[request.auth.uid].keys().hasOnly(["role", "name", "email"])
        && (!("name" in after[request.auth.uid]) || (after[request.auth.uid].name is string && after[request.auth.uid].name.size() <= 100))
        && (!("email" in after[request.auth.uid]) || (after[request.auth.uid].email is string && after[request.auth.uid].email.size() <= 100));
    }

    function isLeaving(teamId) {
      let before = resource.data.members;
      let after = request.resource.data.members;
      return isMember(teamId)
        && memberRole(teamId) != "admin"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["members"])
        && after.diff(before).affectedKeys().hasOnly([request.auth.uid])
        && !(request.auth.uid in after);
    }

    function isCreatorWithAccess() {
      return resource.data.createdBy == request.auth.uid
        && (resource.data.teamId == "" || isMember(resource.data.teamId));
    }

    function isValidRequest(userId) {
      let r = request.resource.data;
      return r.keys().hasOnly(["uid", "name", "email", "status", "createdAt"])
        && r.uid == userId
        && r.status == "pending"
        && r.name is string && r.name.size() <= 100
        && r.email is string && r.email.size() <= 100;
    }

    // -----------------------------------------------------------------------
    // Plays (#68, #76)
    // -----------------------------------------------------------------------

    match /plays/{playId} {
      // Signed-in owner or team member can read
      allow read: if isAppOwner() || isSignedIn() && (
        resource.data.createdBy == request.auth.uid ||
        isMember(resource.data.teamId)
      );

      // Authenticated users can create their own plays
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;

      // Creator or team editor can update. A team play's creator only while
      // still in the team: after leaving (or being removed) it stays the team's.
      allow update: if isSignedIn() && (
        isCreatorWithAccess() ||
        isEditor(resource.data.teamId)
      );

      // Creator (same condition) or team admin can delete
      allow delete: if isAppOwner() || isSignedIn() && (
        isCreatorWithAccess() ||
        isAdmin(resource.data.teamId)
      );
    }

    // -----------------------------------------------------------------------
    // Invite documents (readable by any signed-in user, #75)
    // Each document: invites/{inviteCode} → { teamId, teamName }
    // Lets someone outside the team find it from the link (requestToJoin)
    // without reading the protected team document.
    // -----------------------------------------------------------------------

    match /invites/{inviteCode} {
      allow read: if isSignedIn();
      // Only an admin of the team, for the team's own code; an existing code
      // cannot be pointed at another team.
      allow create: if isAdmin(request.resource.data.teamId)
        && teamData(request.resource.data.teamId).inviteCode == inviteCode;
      allow update: if isAdmin(resource.data.teamId)
        && request.resource.data.teamId == resource.data.teamId;
      allow delete: if isAppOwner();
    }

    // -----------------------------------------------------------------------
    // Comments (#133)
    // Any authenticated user who can read the play may read/add comments.
    // Only the comment author may delete their own comment.
    // Any authenticated user may resolve/update (mark resolved).
    // -----------------------------------------------------------------------

    match /comments/{commentId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn();
      allow delete: if isAppOwner() || isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    // -----------------------------------------------------------------------
    // Shared play tokens (public read-only, #78)
    // -----------------------------------------------------------------------

    match /sharedPlays/{shareToken} {
      // Anyone (even unauthenticated) can open a share link; only the app
      // owner can list them all.
      allow get: if true;
      allow list: if isAppOwner();
      // Only authenticated users can create share tokens, in their own name.
      // teamName is shown publicly under the play title: optional, short text only.
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid && (
        !('teamName' in request.resource.data) ||
        (request.resource.data.teamName is string && request.resource.data.teamName.size() <= 80)
      );
      // The token creator or the app owner can delete it
      allow delete: if isAppOwner() || isSignedIn() && resource.data.createdBy == request.auth.uid;
    }
  }
}
